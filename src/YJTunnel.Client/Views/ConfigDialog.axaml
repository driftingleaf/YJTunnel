<arc:Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
            x:Class="YJTunnel.Client.Views.ConfigDialog"
            Title="连接配置" Width="460" SizeToContent="Height"
            CanResize="False" WindowStartupLocation="CenterOwner"
            ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="14">
        <arc:Input x:Name="ServerAddrInput" Label="服务端地址" Placeholder="如 tunnel.example.com 或 1.2.3.4"
                   Description="YJTunnel 服务端的 IP 或域名" />
        <arc:NumberField x:Name="ServerPortInput" Label="服务端端口" Minimum="1" Maximum="65535"
                         Description="默认 5003" />
        <arc:Input x:Name="TokenInput" Label="接入令牌" Placeholder="向管理员索取"
                   Description="服务端 configs/tunnelserver.json 中 Tokens 之一" />
        <arc:Input x:Name="CompanyNameInput" Label="公司名称" Placeholder="如：新宇科技"
                   Description="上报到服务端，管理台按公司显示" />
        <arc:Checkbox x:Name="MinimizeToTrayCheck" Content="关闭窗口时最小化到托盘（不退出）" />
        <arc:Checkbox x:Name="AutoStartCheck" Content="开机自动启动（最小化到托盘）" />
        <Grid ColumnDefinitions="*,Auto,Auto">
            <arc:Button Content="取消" Variant="Ghost" Click="OnCancelClick" />
            <arc:Button Grid.Column="1" Content="保存" Variant="Primary" Click="OnSaveClick" Margin="10,0,0,0" />
        </Grid>
    </StackPanel>
</arc:Window>
