<arc:Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
            xmlns:arcc="clr-namespace:TKCode.Arc;assembly=TKCode.Arc.Core"
            x:Class="YJTunnel.Client.Views.ConfigDialog"
            Title="连接配置" Width="440" SizeToContent="Height"
            CanResize="False" WindowStartupLocation="CenterOwner"
            ShowInTaskbar="False">

    <StackPanel Margin="20" Spacing="4">

        <TextBlock Text="服务器" FontSize="10.5" FontWeight="SemiBold" Opacity="0.6" Margin="0,2,0,8" />

        <Grid ColumnDefinitions="*,110" Margin="0,0,0,10">
            <arc:Input x:Name="ServerAddrInput" Label="服务端地址" Placeholder="如 tunnel.example.com"
                       Watermark="tunnel.example.com" />
            <arc:NumberField Grid.Column="1" x:Name="ServerPortInput" Label="端口" Margin="10,0,0,0" UseGrouping="False" />
        </Grid>

        <TextBlock Text="身份" FontSize="10.5" FontWeight="SemiBold" Opacity="0.6" Margin="0,8,0,8" />

        <arc:Input x:Name="CompanyNameInput" Label="公司名称（上报管理台）" Placeholder="如：新宇科技" Margin="0,0,0,10" />

        <arc:Input x:Name="TokenInput" Label="接入令牌" Placeholder="向管理员索取" />
        <TextBlock Text="服务端 configs/tunnelserver.json 中 Tokens 之一" FontSize="11" Opacity="0.55"
                   Margin="2,4,0,4" />

        <TextBlock Text="偏好" FontSize="10.5" FontWeight="SemiBold" Opacity="0.6" Margin="0,10,0,8" />

        <arc:Checkbox x:Name="MinimizeToTrayCheck" Content="关闭窗口时最小化到托盘（不退出）" Margin="0,2,0,6" />
        <arc:Checkbox x:Name="AutoStartCheck" Content="开机自动启动（最小化到托盘）" Margin="0,2,0,10" />

        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
            <arc:Button Content="取消" Variant="Ghost" Click="OnCancelClick" />
            <arc:Button Grid.Column="1" Content="保 存" Variant="Primary" MinWidth="88" Click="OnSaveClick" />
        </Grid>
    </StackPanel>
</arc:Window>
