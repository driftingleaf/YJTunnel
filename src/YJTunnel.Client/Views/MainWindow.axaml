<arc:Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
            xmlns:vm="using:YJTunnel.Client.ViewModels"
            x:Class="YJTunnel.Client.Views.MainWindow"
            x:DataType="vm:MainViewModel"
            Title="YJTunnel 客户端" Width="760" Height="560"
            CanResize="True" MinWidth="640" MinHeight="480"
            WindowDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="0">

        <!-- 状态横幅 -->
        <StackPanel Grid.Row="0" Margin="20,18,20,8" Spacing="10">
            <arc:Alert x:Name="StateBanner" IsOpen="True" IsDismissible="False" Tone="Info">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="StateTextBlock" Text="未启动" FontWeight="SemiBold" />
                    <TextBlock x:Name="StateDetailBlock" Text="" Opacity="0.72" />
                </StackPanel>
            </arc:Alert>
        </StackPanel>

        <!-- 主体：服务器信息 + 映射列表 -->
        <ScrollViewer Grid.Row="1" Margin="20,4,20,8">
            <StackPanel Spacing="14">

                <!-- 连接信息卡 -->
                <arc:Card Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="连接配置" FontSize="15" FontWeight="SemiBold" />
                            <arc:Button x:Name="EditConfigButton" Content="编辑配置"
                                        Variant="Secondary" Size="Small"
                                        Click="OnEditConfigClick" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="服务端" Foreground="Gray" Margin="0,0,10,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ServerTextBlock" Margin="0,0,18,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="公司" Foreground="Gray" Margin="0,0,10,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="CompanyTextBlock" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="状态" Foreground="Gray" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StateShortBlock" Margin="0,0,18,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="诊断" Foreground="Gray" Margin="0,0,10,0" />
                            <arc:CopyButton Grid.Row="1" Grid.Column="3" x:Name="CopyDiagButton"
                                            Label="复制诊断" IsIconOnly="False"
                                            Click="OnCopyDiagnosticsClick" />
                        </Grid>
                    </StackPanel>
                </arc:Card>

                <!-- 端口映射 -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="端口映射" FontSize="15" FontWeight="SemiBold" />
                    <arc:Button Grid.Column="1" Content="添加映射" Variant="Primary" Size="Small"
                                Click="OnAddMappingClick" />
                </Grid>
                <TextBlock x:Name="MappingHintBlock" Text="填写本地服务端口与公网访问端口；公网端口由服务端管理员统一规划。"
                           Opacity="0.6" FontSize="12" />

                <!-- 表头 -->
                <Grid ColumnDefinitions="44,1.2*,110,110,1.4*,110,66" Margin="4,0,4,4" Opacity="0.6" TextElement.FontSize="12">
                    <TextBlock Text="启用" />
                    <TextBlock Grid.Column="1" Text="备注" />
                    <TextBlock Grid.Column="2" Text="本地 IP" />
                    <TextBlock Grid.Column="3" Text="本地端口" />
                    <TextBlock Grid.Column="4" Text="说明（自动生成）" />
                    <TextBlock Grid.Column="5" Text="公网端口" />
                    <TextBlock Grid.Column="6" Text="状态" />
                </Grid>
                <ItemsControl x:Name="MappingsList" ItemsSource="{Binding Mappings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MappingItemViewModel">
                            <Grid ColumnDefinitions="44,1.2*,110,110,1.4*,110,66" Margin="4,3,4,3">
                                <arc:Checkbox IsChecked="{Binding Enabled}" HorizontalAlignment="Left" />
                                <arc:Input Grid.Column="1" Text="{Binding Note}" Placeholder="备注"
                                           IsLabelVisible="False" Size="Small" />
                                <arc:Input Grid.Column="2" Text="{Binding LocalIp}" Placeholder="127.0.0.1"
                                           IsLabelVisible="False" Size="Small" />
                                <arc:NumberField Grid.Column="3" Value="{Binding LocalPort}"
                                                 IsLabelVisible="False" Minimum="0" Maximum="65535" />
                                <TextBlock Grid.Column="4" Text="{Binding Description}" VerticalAlignment="Center"
                                           Opacity="0.72" TextTrimming="CharacterEllipsis" />
                                <arc:NumberField Grid.Column="5" Value="{Binding RemotePort}"
                                                 IsLabelVisible="False" Minimum="0" Maximum="65535" />
                                <TextBlock Grid.Column="6" Text="{Binding StatusText}" VerticalAlignment="Center"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,0">
                    <TextBlock Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                               Text="修改后点击「保存并应用」生效。" />
                    <arc:Button Grid.Column="1" x:Name="ApplyButton" Content="保存并应用"
                                Variant="Primary" Click="OnApplyClick" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏：启停 -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="FooterHintBlock" VerticalAlignment="Center" Opacity="0.65" FontSize="12"
                           Text="关闭窗口即最小化到托盘，隧道保持运行。" />
                <arc:Button Grid.Column="1" x:Name="StartStopButton" Content="启动"
                            Variant="Primary" Size="Medium" Margin="0,0,10,0"
                            Click="OnStartStopClick" />
                <arc:Button Grid.Column="2" x:Name="TrayButton" Content="隐藏到托盘"
                            Variant="Secondary" Size="Medium"
                            Click="OnHideToTrayClick" />
            </Grid>
        </Border>
    </Grid>
</arc:Window>
