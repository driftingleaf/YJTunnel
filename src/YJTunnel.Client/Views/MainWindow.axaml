<arc:Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
            xmlns:arcc="clr-namespace:TKCode.Arc;assembly=TKCode.Arc.Core"
            xmlns:vm="using:YJTunnel.Client.ViewModels"
            xmlns:conv="using:YJTunnel.Client.Views"
            x:Class="YJTunnel.Client.Views.MainWindow"
            x:DataType="vm:MainViewModel"
            Title="YJTunnel 客户端" Width="880" Height="620"
            CanResize="True" MinWidth="720" MinHeight="540"
            WindowDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:BoolToOpacityConverter x:Key="RowOpacity" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

        <!-- ① Hero 状态卡 -->
        <Border Grid.Row="0" x:Name="HeroBorder" CornerRadius="12" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="20,16,20,0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,14,16,12">
                    <Border x:Name="HeroDot" Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource SystemControlForegroundBaseHighBrush}">
                        <arc:ArcGlyph x:Name="HeroDotGlyph" Size="17" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="HeroTitleText" Text="未启动" FontSize="16.5" FontWeight="SemiBold" />
                            <Border x:Name="HeroWhenBadge" CornerRadius="999" Padding="9,2"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" IsVisible="False" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroWhenText" FontSize="11" Opacity="0.85" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HeroSubText" Text="配置完成后点击「启动」接入隧道"
                                   FontSize="12.5" Opacity="0.72" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <arc:Button Grid.Column="2" x:Name="StartStopButton" Content="启 动"
                                Variant="Primary" MinWidth="104" Height="40" FontSize="14"
                                VerticalAlignment="Center" Click="OnStartStopClick" />
                </Grid>

                <!-- 指标条 -->
                <Grid ColumnDefinitions="*,1,*,1,*">
                    <Grid RowDefinitions="Auto,Auto" Margin="20,4,20,12" ColumnDefinitions="Auto,*">
                        <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Timer}" Size="12" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="在线时长" FontSize="11.5" Opacity="0.72" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricUptime" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </Grid>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <Grid Grid.Column="2" RowDefinitions="Auto,Auto" Margin="20,4,20,12" ColumnDefinitions="Auto,*">
                        <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Gauge}" Size="12" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="网络延迟" FontSize="11.5" Opacity="0.72" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricLatency" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </Grid>
                    <Border Grid.Column="3" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <Grid Grid.Column="4" RowDefinitions="Auto,Auto" Margin="20,4,20,12" ColumnDefinitions="Auto,*">
                        <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.LockOpen}" Size="12" Opacity="0.6" />
                        <TextBlock Grid.Column="1" Text="已开放端口" FontSize="11.5" Opacity="0.72" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="MetricPorts" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ② 映射区 -->
        <ScrollViewer Grid.Row="2" Margin="20,14,20,6">
            <StackPanel Spacing="10">

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="2,0,2,2">
                    <arc:ArcGlyph VerticalAlignment="Center" Size="13"
                                  Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                  Data="{x:Static arcc:ArcIcons.ArrowDownUp}" />
                    <TextBlock Grid.Column="1" Text="端口映射" FontSize="14.5" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                    <arc:Badge Grid.Column="2" x:Name="MappingCountBadge" Content="0 条" Tone="Neutral"
                               Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <arc:Button Grid.Column="3" Content="编辑配置" Variant="Secondary" Size="Small"
                                VerticalAlignment="Center" Click="OnEditConfigClick" />
                    <arc:Button Grid.Column="4" Content="＋ 添加映射" Variant="Primary" Size="Small"
                                VerticalAlignment="Center" Margin="8,0,0,0" Click="OnAddMappingClick" />
                </Grid>

                <!-- 空态 -->
                <StackPanel x:Name="MappingEmpty" IsVisible="True" Margin="0,16,0,10" Spacing="8">
                    <Border Width="54" Height="54" CornerRadius="15" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource SystemAccentColorDark3}" Offset="0" />
                                <GradientStop Color="{DynamicResource SystemChromeLowColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.ArrowDownUp}" Size="24"
                                      Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="还没有端口映射" FontWeight="SemiBold" FontSize="14.5"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="添加一条映射，把内网服务（如数据库、文件服务）发布到公网"
                               Opacity="0.62" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="430" HorizontalAlignment="Center" />
                    <arc:Button Content="＋ 添加第一条映射" Variant="Primary" HorizontalAlignment="Center"
                                Margin="0,8,0,0" Click="OnAddMappingClick" />
                </StackPanel>

                <!-- 映射行列表 -->
                <ItemsControl x:Name="MappingsList" ItemsSource="{Binding Mappings}" IsVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MappingItemViewModel">
                            <Border CornerRadius="11" Padding="12,10" Margin="0,1"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,0.9*,1.55*,Auto,Auto,Auto"
                                      Opacity="{Binding Enabled, Converter={StaticResource RowOpacity}}">

                                    <arc:Checkbox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LocalTarget}" FontSize="11.5" Opacity="0.62"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- 流向胶囊：本地 → 公网（行内可编辑） -->
                                    <Border Grid.Column="2" CornerRadius="9" VerticalAlignment="Center" Margin="6,0"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1" Padding="10,5">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <TextBlock Text="本地" FontSize="10.5" Opacity="0.55" VerticalAlignment="Center" />
                                            <arc:Input Text="{Binding LocalIp}" IsLabelVisible="False"
                                                       Placeholder="127.0.0.1" Width="96" MinHeight="26" />
                                            <arc:Input Text="{Binding LocalPortText}" IsLabelVisible="False"
                                                       Placeholder="端口" Width="62" MinHeight="26"
                                                       FontFamily="Consolas, 'Cascadia Mono', monospace" />
                                            <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.ArrowRight}" Size="13"
                                                          Opacity="0.5" VerticalAlignment="Center" />
                                            <TextBlock Text="公网" FontSize="10.5" Opacity="0.55" VerticalAlignment="Center" Margin="3,0,0,0" />
                                            <arc:Input Text="{Binding RemotePortText}" IsLabelVisible="False"
                                                       Placeholder="端口" Width="62" MinHeight="26"
                                                       FontFamily="Consolas, 'Cascadia Mono', monospace" />
                                            <arc:Button Variant="Ghost" Click="OnCopyRowAddressClick" Tag="{Binding}"
                                                        VerticalAlignment="Center" Padding="5,4" MinWidth="26" MinHeight="26">
                                                <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Copy}" Size="13" />
                                            </arc:Button>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               FontSize="11.5" Margin="10,0" Opacity="0.9"
                                               Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                    <arc:Button Grid.Column="4" Content="✕" Variant="Ghost" VerticalAlignment="Center"
                                                Padding="6,4" MinWidth="26" MinHeight="26"
                                                Click="OnRemoveMappingClick" Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto" Margin="4,2,2,0">
                    <TextBlock Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                               Text="服务端分配的公网端口以登录回执为准；修改后点「保存并应用」生效。" />
                    <arc:Button Grid.Column="1" x:Name="ApplyButton" Content="保存并应用"
                                Variant="Primary" Click="OnApplyClick" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ③ 底栏 -->
        <Border Grid.Row="3" Padding="20,9"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                <arc:ArcGlyph VerticalAlignment="Center" Size="12" Opacity="0.6"
                              Data="{x:Static arcc:ArcIcons.Server}" />
                <TextBlock Grid.Column="1" x:Name="ServerTextBlock" VerticalAlignment="Center"
                           FontFamily="Consolas, 'Cascadia Mono', monospace" FontSize="11.5" Margin="7,0,0,0" />
                <TextBlock Grid.Column="2" x:Name="CompanyTextBlock" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.8" Margin="18,0,0,0" />
                <TextBlock Grid.Column="3" x:Name="StateShortBlock" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.65" Margin="18,0,0,0" />
                <arc:Button Grid.Column="5" Content="复制诊断" Variant="Ghost" Size="Small"
                            HorizontalAlignment="Right" Click="OnCopyDiagnosticsClick" />
                <arc:Button Grid.Column="6" Content="隐藏到托盘" Variant="Ghost" Size="Small"
                            Margin="6,0,0,0" Click="OnHideToTrayClick" />
            </Grid>
        </Border>
    </Grid>
</arc:Window>
