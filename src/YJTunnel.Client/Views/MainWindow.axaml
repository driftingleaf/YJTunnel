<arc:Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
            xmlns:arcc="clr-namespace:TKCode.Arc;assembly=TKCode.Arc.Core"
            xmlns:vm="using:YJTunnel.Client.ViewModels"
            xmlns:conv="using:YJTunnel.Client.Views"
            x:Class="YJTunnel.Client.Views.MainWindow"
            x:DataType="vm:MainViewModel"
            Icon="/Assets/app.ico"
            FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, PingFang SC"
            Title="YJTunnel 客户端" Width="880" Height="620"
            CanResize="True" MinWidth="720" MinHeight="540"
            WindowDecorations="Full">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:BoolToOpacityConverter x:Key="RowOpacity" />
        <!-- Designer Cut 语义色（与原型一致） -->
        <SolidColorBrush x:Key="YtAccent" Color="#3B63F3" />
        <SolidColorBrush x:Key="YtAccentSoft" Color="#EAEFFF" />
        <SolidColorBrush x:Key="YtGreen" Color="#17995A" />
        <SolidColorBrush x:Key="YtGreenSoft" Color="#E4F5EC" />
        <SolidColorBrush x:Key="YtOrange" Color="#D97C14" />
        <SolidColorBrush x:Key="YtOrangeSoft" Color="#FDF1E0" />
        <SolidColorBrush x:Key="YtRed" Color="#DE4B4B" />
        <SolidColorBrush x:Key="YtRedSoft" Color="#FDEAEA" />
        <SolidColorBrush x:Key="YtInk2" Color="#6A7280" />
        <SolidColorBrush x:Key="YtInk3" Color="#9AA1AC" />
        <FontFamily x:Key="YtMono">Cascadia Code, Cascadia Mono, Consolas, monospace</FontFamily>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

        <!-- ① Hero 状态卡 -->
        <Border Grid.Row="0" x:Name="HeroBorder" CornerRadius="16" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                Margin="22,18,22,0" Padding="22,18,22,0">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,16">
                    <!-- 状态光球：外光晕 + 实心球 -->
                    <Panel VerticalAlignment="Center">
                        <Border x:Name="HeroDotGlow" Width="54" Height="54" CornerRadius="27"
                                IsHitTestVisible="False" Opacity="0.16" />
                        <Border x:Name="HeroDot" Width="44" Height="44" CornerRadius="22"
                                Background="{DynamicResource SystemControlForegroundBaseHighBrush}">
                            <arc:ArcGlyph x:Name="HeroDotGlyph" Size="19" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="HeroTitleText" Text="未启动" FontSize="19" FontWeight="Bold"
                                       LetterSpacing="-0.4" />
                            <Border x:Name="HeroWhenBadge" CornerRadius="999" Padding="10,3"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" IsVisible="False" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroWhenText" FontSize="11" Foreground="{StaticResource YtInk2}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="HeroSubText" Text="配置完成后点击「启动」接入隧道"
                                   FontSize="12.5" Foreground="{StaticResource YtInk2}" Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <arc:Button Grid.Column="2" x:Name="StartStopButton" Content="启 动"
                                Variant="Primary" MinWidth="112" Height="44" FontSize="14" FontWeight="SemiBold"
                                CornerRadius="12" VerticalAlignment="Center" Click="OnStartStopClick" />
                </Grid>

                <!-- 指标带：图标块 + 双行数值 -->
                <Grid ColumnDefinitions="*,1,*,1,*" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,12,0">
                        <Border x:Name="MetricUptimeIcon" Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Timer}" Size="15"
                                          Foreground="{StaticResource YtInk2}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="在线时长" FontSize="11" Foreground="{StaticResource YtInk3}" />
                            <TextBlock x:Name="MetricUptime" Text="—" FontSize="17" FontWeight="Bold"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,14,0,16" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" Margin="22,14,12,0">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Activity}" Size="15"
                                          Foreground="{StaticResource YtInk2}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="网络延迟" FontSize="11" Foreground="{StaticResource YtInk3}" />
                            <TextBlock x:Name="MetricLatency" Text="—" FontSize="17" FontWeight="Bold" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="3" BorderThickness="1,0,0,0"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,14,0,16" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" Margin="22,14,0,0">
                        <Border x:Name="MetricPortsIcon" Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <arc:ArcGlyph x:Name="MetricPortsIconGlyph" Data="{x:Static arcc:ArcIcons.LockOpen}" Size="15"
                                          Foreground="{StaticResource YtInk2}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="已开放端口" FontSize="11" Foreground="{StaticResource YtInk3}" />
                            <TextBlock x:Name="MetricPorts" Text="—" FontSize="17" FontWeight="Bold" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ② 映射区：标题/空态/保存栏固定，仅列表滚动 -->
        <Grid Grid.Row="2" Margin="22,16,22,6" RowDefinitions="Auto,*,Auto" RowSpacing="10">

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="2,0,2,0">
                <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource YtAccentSoft}"
                        VerticalAlignment="Center">
                    <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Globe}" Size="14" Foreground="{StaticResource YtAccent}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="端口映射" FontSize="15" FontWeight="Bold" LetterSpacing="-0.2"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <arc:Badge Grid.Column="2" x:Name="MappingCountBadge" Content="0 条" Tone="Neutral"
                           Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <arc:Button Grid.Column="3" Content="配 置" Variant="Secondary" Size="Small"
                            VerticalAlignment="Center" Click="OnEditConfigClick" />
                <arc:Button Grid.Column="4" Content="＋ 添加映射" Variant="Primary" Size="Small"
                            VerticalAlignment="Center" Margin="8,0,0,0" Click="OnAddMappingClick" />
            </Grid>

            <!-- 滚动区：只包含空态或列表（HorizontalScrollBarVisibility=Hidden 防横向溢出，内容随宽度自适应） -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden">
                <Panel>
                    <!-- 空态：虚线框 + 蓝渐变图标 + 三步胶囊 -->
                    <Panel x:Name="MappingEmpty" IsVisible="True" Margin="0,12,0,8">
                        <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="1.5"
                                   Stroke="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                   StrokeDashArray="4,3" />
                        <StackPanel Margin="0,34,0,32" Spacing="0">
                            <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                                        <GradientStop Color="#383B63F3" Offset="0" />
                                        <GradientStop Color="#0F3B63F3" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Globe}" Size="28" Foreground="{StaticResource YtAccent}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有端口映射" FontWeight="Bold" FontSize="15" LetterSpacing="-0.2"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="三步把内网服务发布到公网" Opacity="0.75" FontSize="12.5"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border CornerRadius="999" BorderThickness="1" Padding="10,3"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <TextBlock Text="① 填本地端口" FontSize="10.5" Foreground="{StaticResource YtInk2}" />
                                </Border>
                                <Border CornerRadius="999" BorderThickness="1" Padding="10,3"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <TextBlock Text="② 申请公网端口" FontSize="10.5" Foreground="{StaticResource YtInk2}" />
                                </Border>
                                <Border CornerRadius="999" BorderThickness="1" Padding="10,3"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                    <TextBlock Text="③ 外网直连" FontSize="10.5" Foreground="{StaticResource YtInk2}" />
                                </Border>
                            </StackPanel>
                            <arc:Button Content="＋ 添加第一条映射" Variant="Primary" HorizontalAlignment="Center"
                                        Margin="0,16,0,0" Click="OnAddMappingClick" />
                        </StackPanel>
                    </Panel>

                    <!-- 映射行列表 -->
                    <ItemsControl x:Name="MappingsList" ItemsSource="{Binding Mappings}" IsVisible="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MappingItemViewModel">
                                <Border CornerRadius="13" Padding="14,12" Margin="0,0,6,9"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,0.75*,1.6*,Auto,Auto"
                                          Margin="0,0,2,0"
                                          Opacity="{Binding Enabled, Converter={StaticResource RowOpacity}}">

                                        <arc:Checkbox IsChecked="{Binding Enabled}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5"
                                                       LetterSpacing="-0.2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LocalTarget}" FontSize="11.5"
                                                       Foreground="{StaticResource YtInk3}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- 流向胶囊：LAN | PUB 双格分色（列用 * 自适应收缩，窄窗口时内容截断不溢出） -->
                                        <Border Grid.Column="2" CornerRadius="10" VerticalAlignment="Center" Margin="6,0"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="1*,1.9*">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,5">
                                                    <TextBlock Text="LAN" FontSize="9.5" FontWeight="Bold" LetterSpacing="1"
                                                               Foreground="{StaticResource YtInk3}" VerticalAlignment="Center" />
                                                    <arc:Input Grid.Column="1" Text="{Binding LocalIp}" IsLabelVisible="False"
                                                               Placeholder="127.0.0.1" MinWidth="44" MinHeight="24" Margin="5,0,0,0" />
                                                    <TextBox Grid.Column="2" Text="{Binding LocalPortText}" Width="48" Height="24" Margin="6,0,0,0"
                                                             Classes="port" FontFamily="Cascadia Code, Consolas, monospace"
                                                             TextAlignment="Center" VerticalContentAlignment="Center" />
                                                </Grid>
                                                <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                        BorderThickness="1,0,0,0"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="8,5">
                                                        <TextBlock Text="PUB" FontSize="9.5" FontWeight="Bold" LetterSpacing="1"
                                                                   Foreground="{StaticResource YtInk3}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PublicHostText}" FontFamily="Cascadia Code, Consolas, monospace"
                                                                   FontSize="12" Foreground="{StaticResource YtInk2}" VerticalAlignment="Center"
                                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBox Grid.Column="2" Text="{Binding RemotePortText}" Width="48" Height="24" Margin="6,0,0,0"
                                                                 Classes="port" FontFamily="Cascadia Code, Consolas, monospace"
                                                                 TextAlignment="Center" VerticalContentAlignment="Center" />
                                                        <arc:Button Grid.Column="3" Variant="Ghost" Click="OnCopyRowAddressClick" Tag="{Binding}"
                                                                    VerticalAlignment="Center" Padding="3,3" MinWidth="22" MinHeight="24" Margin="3,0,0,0">
                                                            <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.Copy}" Size="13" />
                                                        </arc:Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                                   FontSize="11.5" FontWeight="SemiBold" Margin="12,0"
                                                   Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                        <arc:Button Grid.Column="4" Variant="Ghost" VerticalAlignment="Center"
                                                    Padding="5,3" MinWidth="26" MinHeight="26"
                                                    Click="OnRemoveMappingClick" Tag="{Binding}">
                                            <arc:ArcGlyph Data="{x:Static arcc:ArcIcons.X}" Size="13" />
                                        </arc:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </ScrollViewer>

            <!-- 保存栏：固定 -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="2,0,2,0">
                <TextBlock FontSize="12" Foreground="{StaticResource YtInk3}" VerticalAlignment="Center"
                           Text="服务端分配的公网端口以登录回执为准；修改后点「保存并应用」生效。" />
                <arc:Button Grid.Column="1" x:Name="ApplyButton" Content="保存并应用"
                            Variant="Primary" Click="OnApplyClick" />
            </Grid>
        </Grid>

        <!-- ③ 底栏 -->
        <Border Grid.Row="3" Padding="24,9"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
                <arc:ArcGlyph VerticalAlignment="Center" Size="13" Foreground="{StaticResource YtInk3}"
                              Data="{x:Static arcc:ArcIcons.Server}" />
                <TextBlock Grid.Column="1" x:Name="ServerTextBlock" VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" FontWeight="SemiBold"
                           Margin="7,0,0,0" />
                <Ellipse Grid.Column="2" Width="3" Height="3" Fill="{StaticResource YtInk3}" Opacity="0.6"
                         VerticalAlignment="Center" Margin="14,0" />
                <arc:ArcGlyph Grid.Column="3" VerticalAlignment="Center" Size="13" Foreground="{StaticResource YtInk3}"
                              Data="{x:Static arcc:ArcIcons.Share}" />
                <TextBlock Grid.Column="4" x:Name="CompanyTextBlock" VerticalAlignment="Center"
                           FontSize="12" Margin="7,0,0,0" />
                <TextBlock Grid.Column="5" x:Name="StateShortBlock" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource YtInk2}" Margin="14,0,0,0" />
                <arc:Button Grid.Column="6" Content="诊 断" Variant="Ghost" Size="Small"
                            HorizontalAlignment="Right" Click="OnCopyDiagnosticsClick" />
                <arc:Button Grid.Column="7" Content="托 盘" Variant="Ghost" Size="Small"
                            Margin="4,0,0,0" Click="OnHideToTrayClick" />
            </Grid>
        </Border>
    </Grid>
</arc:Window>
