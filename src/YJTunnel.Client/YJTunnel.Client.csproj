<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>YJTunnel.Client</RootNamespace>
		<AssemblyName>YJTunnel.Client</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<!-- AOT（P0 验证项）：发布用 dotnet publish -r win-x64。
		     需 VS2022「使用 C++ 的桌面开发」+ Windows 11 SDK。
		     注意 1：InvariantGlobalization 必须为 false —— TKCode.Arc.NumberField 静态构造硬编码 en-us，
		              全球化不变模式下抛 CultureNotFoundException（实测）。
		     注意 2：部分环境 vswhere -latest 会漏报实例（本机已复现），导致 NativeAOT 找不到 link.exe。
		              发布脚本 scripts/publish-client-aot.bat 先 vcvarsall 再 publish 并传
		              -p:IlcUseEnvironmentalTools=true 绕过该查找（LINK/LIB 由 vcvars 环境提供）。 -->
		<PublishAot>true</PublishAot>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.4" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
		<PackageReference Include="TKCode.Arc" Version="1.0.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YJTunnel\YJTunnel.csproj" />
	</ItemGroup>

</Project>
