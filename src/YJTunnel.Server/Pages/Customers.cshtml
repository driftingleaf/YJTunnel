@page
@model YJTunnel.Server.Pages.CustomersModel
@{
    ViewData["Title"] = "客户管理";
    var onlineIds = Model.OnlineIds;
}
@if (Model.Message != null)
{
    <div class="alert @(Model.IsError ? "err" : "ok")">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
        <span>@Model.Message</span>
    </div>
}

<div class="card">
    <div class="card-head"><h3>@(Model.Editing == null ? "新增客户" : $"编辑客户：{Model.Editing.Name}")</h3>
        <span class="sub">保存后在线客户端将自动重连取新配置（&lt;10s 生效）</span>
    </div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="isNew" value="@(Model.Editing == null ? "1" : "0")" />
            <div class="form-grid">
                <div class="field">
                    <label>ClientId</label>
                    @if (Model.Editing == null)
                    {
                        <input type="text" name="clientId" placeholder="客户端生成的 GUID（见端口设置页日志）" required />
                    }
                    else
                    {
                        <input type="text" name="clientId" value="@Model.Editing.ClientId" readonly />
                    }
                </div>
                <div class="field"><label>名称</label><input type="text" name="name" value="@(Model.Editing?.Name)" required placeholder="如：某某有限公司" /></div>
                <div class="field"><label>备注</label><input type="text" name="note" value="@(Model.Editing?.Note)" placeholder="选填" /></div>
                <div class="field"><label>状态</label>
                    <label class="check"><input type="checkbox" name="enabled" value="true" checked="@(Model.Editing == null || Model.Editing.Enabled)" /> 启用该客户</label>
                </div>
            </div>
            <div style="margin-top:16px;display:flex;gap:10px">
                <button type="submit" asp-page-handler="Save" class="btn primary">保存</button>
                @if (Model.Editing != null)
                {
                    <a class="btn" asp-page="/Customers">取消</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-head">
        <h3>客户列表</h3>
        <span class="sub" id="count">@Model.Customers.Count 个客户</span>
        <span class="spacer"></span>
        <input type="text" placeholder="搜索名称 / ClientId / 机器名…" data-filter="#cust-table" />
    </div>
    <div class="table-wrap">
        <table class="list" id="cust-table">
            <thead>
                <tr>
                    <th>客户</th><th>ClientId</th><th>机器名 / 版本</th><th>最后登录</th><th>端口映射</th><th>状态</th><th class="actions" style="text-align:right">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    var online = onlineIds.Contains(c.ClientId);
                    <tr>
                        <td>
                            <span style="display:inline-flex;align-items:center;gap:10px">
                                <span class="avatar" style="background:@YJTunnel.Server.Pages.CustomersModel.AvatarColor(c.ClientId + c.Name)">@(string.IsNullOrEmpty(c.Name) ? "?" : c.Name[0].ToString())</span>
                                <span>
                                    <span class="td-main">@c.Name</span>
                                    @if (!string.IsNullOrEmpty(c.Note))
                                    {
                                        <div style="color:var(--muted);font-size:12px">@c.Note</div>
                                    }
                                </span>
                            </span>
                        </td>
                        <td class="mono">@c.ClientId[..Math.Min(8, c.ClientId.Length)]…<button class="ibtn" title="复制完整 ClientId" onclick="copyText('@c.ClientId')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg></button></td>
                        <td>@c.MachineName <span class="chip">@c.AppVersion</span></td>
                        <td class="mono">@c.LastLoginAt</td>
                        <td>
                            @foreach (var m in c.Mappings)
                            {
                                <span class="chip mono">@m.Key → @m.RemotePort</span>
                            }
                        </td>
                        <td>
                            @if (!c.Enabled)
                            {
                                <span class="pill err">已禁用</span>
                            }
                            else if (c.BannedUntil is { } b && b > DateTime.Now)
                            {
                                <span class="pill warn" title="临时封禁中，到期后客户端自动恢复">已封禁至 @b.LocalDateTime.ToString("MM-dd HH:mm")</span>
                            }
                            else if (online)
                            {
                                <span class="pill ok">在线</span>
                            }
                            else
                            {
                                <span class="pill off">离线</span>
                            }
                        </td>
                        <td class="actions" style="text-align:right">
                            <a class="btn sm" asp-page="/Customers" asp-route-edit="@c.ClientId">编辑</a>
                            @if (online)
                            {
                                <form class="inline" method="post" asp-page-handler="Kick" onsubmit="return openKickModal(this, '@c.Name')">
                                    <input type="hidden" name="clientId" value="@c.ClientId" />
                                    <input type="hidden" name="banMode" />
                                    <input type="hidden" name="banMinutes" />
                                    <button class="btn sm">踢下线</button>
                                </form>
                            }
                            <form class="inline" method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除客户「@c.Name」？\n\n其端口分配记录将一并删除，客户端将无法登录。')">
                                <input type="hidden" name="clientId" value="@c.ClientId" />
                                <button class="btn sm danger">删除</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Customers.Count == 0)
                {
                    <tr><td colspan="7">
                        <div class="empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <p>暂无客户 · 迁移期客户端登录后将自动建档</p>
                        </div>
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>


<style>
    .kmodal-mask { position: fixed; inset: 0; background: rgba(15, 23, 42, .5); display: none; align-items: center; justify-content: center; z-index: 1000; }
    .kmodal-mask.show { display: flex; }
    .kmodal { background: #fff; border-radius: 12px; width: 440px; max-width: 94vw; box-shadow: 0 16px 48px rgba(0,0,0,.22); overflow: hidden; animation: kmodal-in .18s ease-out; }
    @@keyframes kmodal-in { from { transform: translateY(-14px) scale(.97); opacity: 0 } to { transform: none; opacity: 1 } }
    .kmodal-head { padding: 14px 20px; background: #fef2f2; border-bottom: 1px solid #fecaca; }
    .kmodal-head .tag { display: inline-block; background: #dc2626; color: #fff; font-size: 11px; font-weight: 600; letter-spacing: 2px; padding: 2px 10px; border-radius: 999px; }
    .kmodal-head h4 { margin: 8px 0 0; font-size: 15px; color: #0f172a; font-weight: 600; }
    .kmodal-body { padding: 14px 20px; font-size: 13px; color: #334155; line-height: 1.7; }
    .kmodal-body label.opt { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 8px; margin: 6px 0; cursor: pointer; }
    .kmodal-body label.opt:has(input:checked) { border-color: #dc2626; background: #fef2f2; }
    .kmodal-body select { padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; }
    .kmodal-foot { padding: 12px 20px; display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #e2e8f0; background: #f8fafc; }
    .kmodal-foot button { min-width: 88px; padding: 8px 14px; border-radius: 8px; font-size: 13px; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; color: #334155; }
    .kmodal-foot button:hover { background: #f1f5f9; }
    .kmodal-foot button.confirm { background: #dc2626; border-color: #dc2626; color: #fff; font-weight: 600; }
    .kmodal-foot button.confirm:hover { background: #b91c1c; }
</style>

<div class="kmodal-mask" id="kickModal">
    <div class="kmodal">
        <div class="kmodal-head">
            <span class="tag">高危操作</span>
            <h4>踢下线客户「<span id="km-name"></span>」</h4>
        </div>
        <div class="kmodal-body">
            <label class="opt"><input type="radio" name="kmode" value="disconnect" checked /> 仅断开当前会话（客户端几秒内自动重连）</label>
            <label class="opt"><input type="radio" name="kmode" value="temp" /> 临时封禁（期内登录将被拒绝，到期自动恢复）：
                <select id="km-minutes">
                    <option value="5">5 分钟</option>
                    <option value="30" selected>30 分钟</option>
                    <option value="60">1 小时</option>
                    <option value="1440">24 小时</option>
                </select>
            </label>
            <label class="opt"><input type="radio" name="kmode" value="permanent" /> 永久封禁（禁用客户，需编辑客户重新启用）</label>
        </div>
        <div class="kmodal-foot">
            <button type="button" onclick="closeKickModal()">取消</button>
            <button type="button" class="confirm" onclick="submitKickModal()">确认执行</button>
        </div>
    </div>
</div>

<script>
    var _kickForm = null;
    function openKickModal(form, name) {
        _kickForm = form;
        document.getElementById('km-name').textContent = name;
        document.getElementById('kickModal').classList.add('show');
        return false; // 一律拦截默认提交，由模态框确认后提交
    }
    function closeKickModal() { document.getElementById('kickModal').classList.remove('show'); }
    function submitKickModal() {
        if (!_kickForm) return;
        var mode = document.querySelector('input[name="kmode"]:checked').value;
        _kickForm.querySelector('[name=banMode]').value = mode;
        _kickForm.querySelector('[name=banMinutes]').value = mode === 'temp' ? document.getElementById('km-minutes').value : 0;
        closeKickModal();
        _kickForm.submit();
    }
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeKickModal();
    });
    document.getElementById('kickModal').addEventListener('click', function (e) {
        if (e.target === this) closeKickModal();
    });
</script>
