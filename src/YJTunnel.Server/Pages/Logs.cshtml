@page
@model YJTunnel.Server.Pages.LogsModel
@{
    ViewData["Title"] = "操作日志";
}
<div class="card">
    <div class="card-head">
        <h3>操作日志</h3>
        <span class="sub">events.jsonl 时间线 · 最新在前 · 最多 500 条</span>
        <span class="spacer"></span>
        <form method="get" class="toolbar">
            <input type="text" name="clientId" value="@Model.ClientIdFilter" placeholder="按 ClientId 筛选" style="width:210px" />
            <input type="text" name="type" value="@Model.TypeFilter" placeholder="按类型筛选（如 login_ok）" style="width:190px" />
            <button class="btn primary" type="submit">查询</button>
        </form>
    </div>
    <div class="table-wrap">
        <table class="list">
            <thead>
                <tr><th>时间</th><th>级别</th><th>类型</th><th>客户</th><th>来源 IP</th><th>内容</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Events)
                {
                    var level = e.TryGetValue("level", out var lv) ? lv?.ToString() : "";
                    <tr>
                        <td class="mono" style="white-space:nowrap">@e["time"]</td>
                        <td>
                            @switch (level)
                            {
                                case "error":<span class="pill err">错误</span>break;
                                case "warn":<span class="pill warn">警告</span>break;
                                default:<span class="pill info">信息</span>break;
                            }
                        </td>
                        <td><span class="chip mono">@e["type"]</span></td>
                        <td class="mono">@(e.TryGetValue("clientId", out var cid) ? cid : "")</td>
                        <td class="mono">@(e.TryGetValue("remoteIp", out var ip) ? ip : "")</td>
                        <td>@e["msg"]</td>
                    </tr>
                }
                @if (Model.Events.Count == 0)
                {
                    <tr><td colspan="6">
                        <div class="empty">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                            <p>无匹配事件</p>
                        </div>
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
