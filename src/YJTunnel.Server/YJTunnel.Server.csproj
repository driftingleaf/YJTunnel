<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<OutputType>Exe</OutputType>
		<AssemblyName>YJTunnel.Server</AssemblyName>
		<RootNamespace>YJTunnel.Server</RootNamespace>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- Web SDK 自带 Microsoft.AspNetCore.App FrameworkReference（§十一） -->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\YJTunnel\YJTunnel.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="configs\tunnelserver.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="deploy\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
