{
  "Server": {
    "ServerAddr": "127.0.0.1",
    "ServerPort": 5003
  },
  // 备用服务器（可选）：主端点连续失败 3 次自动切换
  "BackupServer": null,
  // 与服务端 tunnelserver.json 的 Tokens 一致
  "Token": "your-token-here",
  // 留空 = 首次运行自动生成并保存到 clientid.txt
  "ClientId": "",
  // 公司名（可选）：服务端管理台/待审核队列会显示
  "CompanyName": "示例公司",
  // RemotePort=0 表示由服务端自动分配；已有分配的端口原样沿用
  "Forwards": [
    { "LocalIp": "127.0.0.1", "LocalPort": 8080, "RemotePort": 0 }
  ]
}
